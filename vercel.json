{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/musculo-v1",
      "destination": "/reto-mas-musculo",
      "permanent": true
    },
    {
      "source": "/musculo-v1/:resto*",
      "destination": "/reto-mas-musculo/:resto*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:landing(reto-mas-musculo|reto-mas-musculo-m|reto-mas-musculo-t|musculo-v5|musculo-v6)/:canal(meta|influencer|instagram|email|whatsapp|DaniNajera|AleRivera)",
      "destination": "/:landing"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
